<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EMAMUAIAPP.OrdenesPage"
             Title="Órdenes de Trabajo">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Órdenes de Trabajo"
               FontSize="24"
               HorizontalOptions="Center" />

        <Button Text="Agregar Nueva Orden"
                Clicked="OnAgregarOrdenClicked" />

        <CollectionView x:Name="OrdenesCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Gray" Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Label Text="{Binding NombreEquipo}" FontAttributes="Bold" />
                            <Label Text="{Binding CodigoEquipo}" />
                            <Label Text="{Binding TipoMantenimiento}" />
                            <Label Text="{Binding Estado}" />
                            <Label Text="{Binding FechaIngreso, StringFormat='Ingreso: {0:dd/MM/yyyy}'}" />
                            <Label Text="{Binding FechaEntrega, StringFormat='Entrega: {0:dd/MM/yyyy}'}" />
                            <Label Text="{Binding DescripcionProblema}" />
                            <Label Text="{Binding Observaciones}" />
                            <HorizontalStackLayout>
                                <Button Text="Editar" Clicked="OnEditarOrdenClicked" CommandParameter="{Binding}" />
                                <Button Text="Eliminar" Clicked="OnEliminarOrdenClicked" CommandParameter="{Binding}" BackgroundColor="Red" TextColor="White" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
