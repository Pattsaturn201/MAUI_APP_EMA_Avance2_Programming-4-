<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EMAMUAIAPP.MainPage"
             Title="Inicio"
             BackgroundColor="LightGoldenrodYellow">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="30" VerticalOptions="CenterAndExpand">

            <!-- Tarjeta de bienvenida -->
            <Frame Padding="20"
                   BackgroundColor="White"
                   CornerRadius="20"
                   HasShadow="True"
                   BorderColor="#ccc">

                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Image
                        Source="ema.png"
                        HeightRequest="240"
                        Aspect="AspectFit" />

                    <Label
                        Text="E.M.A"
                        FontSize="34"
                        FontAttributes="Bold"
                        TextColor="#222" />

                    <Label
                        Text="Bienvenido a nuestra aplicación. Selecciona una opción para comenzar:"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        TextColor="#555"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- Botones de navegación con sombra -->
            <VerticalStackLayout Spacing="18">
                <Frame HasShadow="True" Padding="0" CornerRadius="14" BackgroundColor="Transparent">
                    <Button
                        Text="Gestión de Clientes"
                        Clicked="OnClientesClicked"
                        BackgroundColor="#4a90e2"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="55" />
                </Frame>

                <Frame HasShadow="True" Padding="0" CornerRadius="14" BackgroundColor="Transparent">
                    <Button
                        Text="Gestión de Equipos"
                        Clicked="OnEquiposClicked"
                        BackgroundColor="#50e3c2"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="55" />
                </Frame>

                <Frame HasShadow="True" Padding="0" CornerRadius="14" BackgroundColor="Transparent">
                    <Button
                        Text="Gestión de Pagos"
                        Clicked="OnPagosClicked"
                        BackgroundColor="#f5a623"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="55" />
                </Frame>

                <Frame HasShadow="True" Padding="0" CornerRadius="14" BackgroundColor="Transparent">
                    <Button
                        Text="Gestión de Órdenes de Trabajo"
                        Clicked="OnOrdenesClicked"
                        BackgroundColor="#d0021b"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="55" />
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

