<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EMAMUAIAPP.ClientesPage"
             Title="Clientes">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20" RowSpacing="15">

        <!-- Título -->
        <Label Text="Clientes Registrados"
               FontSize="24"
               HorizontalOptions="Center"
               Grid.Row="0" />
        
        <Entry x:Name="BusquedaEntry"
               Placeholder="Buscar por nombre, apellido o correo"
               TextChanged="OnBusquedaTextChanged"
               Grid.Row="1"/>

        <!-- Botón pa agregar cliente -->
        <Button Text="Agregar Cliente"
                Clicked="OnAgregarClienteClicked"
                Grid.Row="2" />

        <!-- Lista de clientes con scroll  -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="10">
                <CollectionView x:Name="ClientesCollectionView"
                                ItemsLayout="VerticalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="LightGray" Padding="10" Margin="5">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" FontSize="18" />
                                    <Label Text="{Binding ApellidoCompleto}" FontAttributes="Italic" />
                                    <Label Text="{Binding Correo}" />
                                    <Label Text="{Binding Telefono}" />
                                    <Label Text="{Binding Direccion}" />
                                    <Label Text="Métodos de Pago:" FontAttributes="Bold" />
                                    <Label Text="{Binding MetodosDePagoString}" LineBreakMode="WordWrap" />

                                    <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                                        <Button Text="Editar"
                                                Clicked="OnEditarClienteClicked"
                                                BackgroundColor="#4CAF50"
                                                TextColor="White"/>
                                        <Button Text="Eliminar"
                                                Clicked="OnEliminarClienteClicked"
                                                BackgroundColor="#F44336"
                                                TextColor="White"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
