<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EMAMUAIAPP.PagosPage"
             Title="Pagos"
             BackgroundColor="#F0F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Historial de Pagos"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#2C3E50"
                   HorizontalOptions="Center" />

            <SearchBar Placeholder="Buscar pagos..."
                       x:Name="BusquedaPagosBar"
                       TextChanged="OnBusquedaPagosChanged"
                       PlaceholderColor="#B0BEC5"
                       BackgroundColor="White"
                       TextColor="#2C3E50"
                       FontSize="16"
                       HeightRequest="44" />

            <Button Text="Registrar Pago"
                    Clicked="OnAgregarPagoClicked"
                    BackgroundColor="#3498DB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

            <CollectionView x:Name="PagosCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnPagoSeleccionado">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White"
                               BorderColor="#D0D7DE"
                               CornerRadius="12"
                               Padding="15"
                               Margin="0,10"
                               HasShadow="True">

                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding VentaId, StringFormat='Venta ID: {0}'}"
                                       FontSize="16"
                                       TextColor="#37474F" />
                                <Label Text="{Binding Monto, StringFormat='Monto: {0:C}'}"
                                       FontSize="16"
                                       TextColor="#37474F" />
                                <Label Text="{Binding FechaPago, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                                       FontSize="16"
                                       TextColor="#37474F" />
                                <Label Text="{Binding EntidadExterna, StringFormat='Entidad: {0}'}"
                                       FontSize="16"
                                       TextColor="#37474F" />
                                <Label Text="{Binding MetodoPago, StringFormat='Método: {0}'}"
                                       FontSize="16"
                                       TextColor="#37474F" />
                                <Label Text="{Binding DetallesCuenta, StringFormat='Cuenta: {0}'}"
                                       FontSize="16"
                                       TextColor="#37474F" />

                                <HorizontalStackLayout Spacing="15" Margin="0,10,0,0">
                                    <Button Text="Editar"
                                            Clicked="OnEditarPagoClicked"
                                            BackgroundColor="#2ECC71"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            CommandParameter="{Binding}" />
                                    <Button Text="Eliminar"
                                            Clicked="OnEliminarPagoClicked"
                                            BackgroundColor="#E74C3C"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
