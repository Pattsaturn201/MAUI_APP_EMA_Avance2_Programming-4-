<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DivisaAPPMaui.ViewModels"
             x:Class="DivisaAPPMaui.Views.CurrencyExchangeView"
             Title="CurrencyExchangeView">
    
    <ContentPage.BindingContext>
        <local:CurrencyExchangeViewModel />
    </ContentPage.BindingContext>
    
    
    
    <VerticalStackLayout>
        
        <Image
            Source="dotnet_bot.png"
            HeightRequest="185"
            Aspect="AspectFill"
            SemanticProperties.Description="dot net lala"/>

        <Label 
            Text="USD"/>


        <Entry
            x:Name="USDvalue"
            Placeholder="Enter the USD value"
            Text="{Binding EUROValue }" />

        <Label 
            Text="USD"/>


        <Entry
            x:Name="USDvalue"
            Placeholder="Enter the USD value"
            Text="{Binding EUROValue }" />

        <Button
            x: Name ="ShowResultsBtn"
            Text="Show Results"
            Command="{Binding ShowResultsCommand}"
            HorizontalOptions="Fill" />





    </VerticalStackLayout>
</ContentPage>