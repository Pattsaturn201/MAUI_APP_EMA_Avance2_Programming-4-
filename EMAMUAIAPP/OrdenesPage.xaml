<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EMAMUAIAPP.OrdenesPage"
             Title="Órdenes de Trabajo"
             BackgroundColor="#F0F4F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Órdenes de Trabajo"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#2C3E50"
                   HorizontalOptions="Center" />

            <Button Text="Agregar Nueva Orden"
                    Clicked="OnAgregarOrdenClicked"
                    BackgroundColor="#3498DB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

            <CollectionView x:Name="OrdenesCollectionView"
                            ItemsLayout="VerticalList"
                            VerticalOptions="FillAndExpand">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White"
                               BorderColor="#D0D7DE"
                               CornerRadius="12"
                               Padding="15"
                               Margin="0,10"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="5">

                                <Label Text="{Binding NombreEquipo}" FontAttributes="Bold" FontSize="18" TextColor="#37474F" />
                                <Label Text="{Binding CodigoEquipo}" TextColor="#546E7A" />
                                <Label Text="{Binding TipoMantenimiento}" TextColor="#546E7A" />
                                <Label Text="{Binding Estado}" TextColor="#546E7A" />
                                <Label Text="{Binding FechaIngreso, StringFormat='Ingreso: {0:dd/MM/yyyy}'}" TextColor="#546E7A" />
                                <Label Text="{Binding FechaEntrega, StringFormat='Entrega: {0:dd/MM/yyyy}'}" TextColor="#546E7A" />
                                <Label Text="{Binding DescripcionProblema}" TextColor="#546E7A" />
                                <Label Text="{Binding Observaciones}" TextColor="#546E7A" />

                                <HorizontalStackLayout Spacing="15" Margin="0,10,0,0">
                                    <Button Text="Editar"
                                            Clicked="OnEditarOrdenClicked"
                                            BackgroundColor="#2ECC71"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            CommandParameter="{Binding}" />
                                    <Button Text="Eliminar"
                                            Clicked="OnEliminarOrdenClicked"
                                            BackgroundColor="#E74C3C"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
