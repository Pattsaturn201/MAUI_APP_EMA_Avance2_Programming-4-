<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EMAMUAIAPP.OrdenesPage"
             Title="Órdenes de Trabajo">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Órdenes de Trabajo"
               FontSize="24"
               HorizontalOptions="Center" />

        <Button Text="Agregar Nueva Orden"
                Clicked="OnAgregarOrdenClicked" />

        <ScrollView>
            <CollectionView x:Name="OrdenesCollectionView"
                VerticalOptions="FillAndExpand">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" Padding="10" Margin="20">
                            <VerticalStackLayout BackgroundColor="Black">
                                <Label Text="{Binding NombreEquipo}" FontAttributes="Bold" TextColor="White" />
                                <Label Text="{Binding CodigoEquipo}" TextColor="White" />
                                <Label Text="{Binding TipoMantenimiento}" TextColor="White" />
                                <Label Text="{Binding Estado}" TextColor="White" />
                                <Label Text="{Binding FechaIngreso, StringFormat='Ingreso: {0:dd/MM/yyyy}'}" TextColor="White" />
                                <Label Text="{Binding FechaEntrega, StringFormat='Entrega: {0:dd/MM/yyyy}'}" TextColor="White" />
                                <Label Text="{Binding DescripcionProblema}" TextColor="White" />
                                <Label Text="{Binding Observaciones}" TextColor="White" />
                                <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                                    <Button Text="Editar" 
                                Clicked="OnEditarOrdenClicked" 
                                CommandParameter="{Binding}"
                                BackgroundColor="CadetBlue" 
                                TextColor="White"/>
                                    <Button Text="Eliminar" 
                                Clicked="OnEliminarOrdenClicked"
                                CommandParameter="{Binding}" 
                                BackgroundColor="Red" 
                                TextColor="White" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

    </VerticalStackLayout>
</ContentPage>
